################################################################################
# Visual Studio / .NET general .gitignore
# Generated from GitHub's VisualStudio.gitignore with some project-specific additions removed
################################################################################

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
**/bin/
**/obj/

# Visual Studio temporary files, build results, and log files
.vs/
*.cache
*.log
*.vsix

# Visual Studio Code workspace settings
.vscode/

# Rider project files
.idea/

# NuGet
# NuGet Packages folder
**/packages/
# NuGet v3's project.json files
project.lock.json
project.assets.json
*.nupkg

# MSBuild generated files
*.dbmdl
*.jfm
*.pdb
*.dll
*.exe
*.app
*.msi
*.msix
*.appinstaller

# OS generated files
*.DS_Store
Thumbs.db

# Test results
TestResults/

# JetBrains Rider
.idea/

# Ignore user secrets file
secrets.json

# DotNet publish
publish/

# Other
*.sdf
*.ipch
*.sqlite
*.db
*.db-shm
*.db-wal
